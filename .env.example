# korbPuls configuration — copy to .env and edit.
# Only KORBPULS_API_KEY is required; everything else is optional.

# --- Required ---
# Secret used to protect the /api/ endpoints. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KORBPULS_API_KEY=

# --- Optional: AI features ---
# Set all three OPENAILIKE_* vars to enable the AI agents.
# Leave empty to disable AI entirely.
OPENAILIKE_API_BASE=
OPENAILIKE_API_KEY=
OPENAILIKE_LLM=

# --- Optional: Langfuse tracing ---
# Traces every AI agent call to Langfuse. Tracing is fully opt-in:
# leave LANGFUSE_SECRET_KEY empty for zero overhead.
# Get these from your Langfuse project settings.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
